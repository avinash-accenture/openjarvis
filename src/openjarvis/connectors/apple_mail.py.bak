"""Read locally synchronized Apple Mail messages from macOS Mail's database."""

from __future__ import annotations

import html
import sqlite3
import subprocess
from datetime import datetime, timedelta, timezone
from email import policy
from email.parser import BytesParser
from email.utils import parseaddr
from html.parser import HTMLParser
from pathlib import Path
from typing import Iterator, Optional
from zoneinfo import ZoneInfo

from openjarvis.connectors._stubs import BaseConnector, Document, SyncStatus
from openjarvis.core.registry import ConnectorRegistry


_MAIL_DB = Path.home() / "Library/Mail/V9/MailData/Envelope Index"
_MAIL_ROOT = Path.home() / "Library/Mail/V9"

_ACCOUNTS = (
    ("iCloud", "0215DEC8-BEA3-46CA-A1E7-53BDA887E9B2",
     "imap://0215DEC8-BEA3-46CA-A1E7-53BDA887E9B2/INBOX"),
    ("Gmail", "8F4B893C-6CB4-4BB4-A24F-0BD083DDFEA4",
     "imap://8F4B893C-6CB4-4BB4-A24F-0BD083DDFEA4/INBOX"),
    ("Yahoo Avi", "7E7AA7B5-C367-48B2-A2D1-5A6A5ACFA1AF",
     "imap://7E7AA7B5-C367-48B2-A2D1-5A6A5ACFA1AF/INBOX"),
    ("Yahoo Pavi", "B5548858-E285-437C-8BAF-3167AA50E1AF",
     "imap://B5548858-E285-437C-8BAF-3167AA50E1AF/INBOX"),
    ("Outlook", "9F267112-858D-4F70-A69C-4D6969C038AA",
     "ews://9F267112-858D-4F70-A69C-4D6969C038AA/Inbox"),
)
_LOCAL_TZ = ZoneInfo("America/New_York")
_MAX_BODY_CHARS = 3000


class _HTMLTextParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.parts: list[str] = []

    def handle_data(self, data: str) -> None:
        value = data.strip()
        if value:
            self.parts.append(value)

    def text(self) -> str:
        return " ".join(self.parts)


def _html_to_text(value: str) -> str:
    parser = _HTMLTextParser()
    try:
        parser.feed(value)
        return html.unescape(parser.text())
    except Exception:
        return ""


def _message_body(message) -> str:
    """Extract readable text while excluding attachment payloads."""
    plain_parts: list[str] = []
    html_parts: list[str] = []

    parts = message.walk() if message.is_multipart() else [message]

    for part in parts:
        if part.is_multipart():
            continue
        if part.get_content_disposition() == "attachment":
            continue
        if part.get_filename():
            continue

        content_type = part.get_content_type()
        if content_type not in ("text/plain", "text/html"):
            continue

        try:
            content = part.get_content()
        except Exception:
            continue

        if not isinstance(content, str):
            continue

        if content_type == "text/plain":
            plain_parts.append(content)
        else:
            html_parts.append(_html_to_text(content))

    result = "\n".join(plain_parts).strip()
    if not result:
        result = "\n".join(html_parts).strip()

    return result[:_MAX_BODY_CHARS]


def _read_gmail_inbox(
    since: datetime,
    max_messages: int,
) -> list[Document]:
    """Read Gmail Inbox in small batches through local Apple Mail."""

    batch_size = 5
    documents: list[Document] = []
    offset = 0
    total_limit = max(1, int(max_messages))
    cutoff = since.astimezone(_LOCAL_TZ)

    while len(documents) < total_limit:
        current_batch = min(
            batch_size,
            total_limit - len(documents),
        )

        script = r'''
on flattenText(theValue)
    set t to theValue as text
    set oldDelimiters to AppleScript's text item delimiters
    set AppleScript's text item delimiters to {return, linefeed, tab}
    set textParts to text items of t
    set AppleScript's text item delimiters to " "
    set t to textParts as text
    set AppleScript's text item delimiters to oldDelimiters
    return t
end flattenText

tell application "Mail"
    set theAccount to first account whose name is "Google"
    set theMailbox to first mailbox of theAccount whose name is "INBOX"

    set totalCount to count of messages of theMailbox
    set startIndex to OFFSET_VALUE + 1
    set endIndex to OFFSET_VALUE + BATCH_LIMIT

    if startIndex > totalCount then return ""

    if endIndex > totalCount then
        set endIndex to totalCount
    end if

    set outputText to ""

    repeat with i from startIndex to endIndex
        set theMessage to message i of theMailbox
        set receivedDate to date received of theMessage

        set mailId to id of theMessage as string
        set rfcMessageId to message id of theMessage as text
        set senderText to my flattenText(sender of theMessage)
        set subjectText to my flattenText(subject of theMessage)
        set bodyText to my flattenText(content of theMessage)

        set readValue to read status of theMessage
        set flaggedValue to flagged status of theMessage

        set y to year of receivedDate as integer as string
        set m to month of receivedDate as integer as string
        set d to day of receivedDate as string
        set h to hours of receivedDate as string
        set n to minutes of receivedDate as string
        set s to seconds of receivedDate as string

        set rowText to mailId & tab & rfcMessageId & tab & ¬
            senderText & tab & subjectText & tab & ¬
            y & tab & m & tab & d & tab & h & tab & n & tab & s & tab & ¬
            (readValue as string) & tab & ¬
            (flaggedValue as string) & tab & bodyText

        set outputText to outputText & rowText & linefeed
    end repeat

    return outputText
end tell
'''

        script = script.replace(
            "OFFSET_VALUE",
            str(offset),
        ).replace(
            "BATCH_LIMIT",
            str(current_batch),
        )

        try:
            result = subprocess.run(
                ["/usr/bin/osascript", "-e", script],
                capture_output=True,
                text=True,
                timeout=30,
                check=True,
            )
        except subprocess.TimeoutExpired as exc:
            raise RuntimeError(
                f"Gmail Inbox timed out at message offset {offset}."
            ) from exc
        except subprocess.CalledProcessError as exc:
            detail = (exc.stderr or str(exc)).strip()
            raise RuntimeError(
                f"Gmail Inbox failed at message offset {offset}: {detail}"
            ) from exc

        lines = result.stdout.splitlines()

        if not lines:
            break

        stop_for_old_message = False

        for line in lines:
            fields = line.split("\t", 12)

            if len(fields) != 13:
                continue

            (
                mail_id,
                rfc_message_id,
                sender_header,
                subject,
                year,
                month,
                day,
                hour,
                minute,
                second,
                read_value,
                flagged_value,
                body,
            ) = fields

            try:
                timestamp = datetime(
                    int(year),
                    int(month),
                    int(day),
                    int(hour),
                    int(minute),
                    int(second),
                    tzinfo=_LOCAL_TZ,
                )
            except (ValueError, TypeError):
                continue

            if timestamp < cutoff:
                stop_for_old_message = True
                break

            sender_name, sender_address = parseaddr(sender_header)
            sender = (
                sender_address
                or sender_name
                or "Unknown sender"
            )

            documents.append(
                Document(
                    doc_id=f"apple_mail:gmail:{mail_id}",
                    source="apple_mail",
                    doc_type="email",
                    title=subject.strip() or "(No subject)",
                    author=sender,
                    participants=[sender],
                    content=body[:_MAX_BODY_CHARS],
                    timestamp=timestamp,
                    thread_id=rfc_message_id,
                    metadata={
                        "account": "Gmail",
                        "unread": read_value.lower() == "false",
                        "flagged": flagged_value.lower() == "true",
                        "body_available": True,
                        "mailbox": "Inbox",
                        "message_id": rfc_message_id,
                        "mail_id": mail_id,
                    },
                )
            )

        if stop_for_old_message:
            break

        offset += current_batch

    return documents

def _read_emlx(path: Path) -> tuple[str, bool]:
    """Return body text and whether the local message file was readable."""
    try:
        raw = path.read_bytes()
        _, separator, payload = raw.partition(b"\n")
        if not separator:
            payload = raw

        message = BytesParser(policy=policy.default).parsebytes(payload)
        return _message_body(message), True
    except (OSError, ValueError, TypeError):
        return "", False


def _open_mail_db() -> Optional[sqlite3.Connection]:
    try:
        uri = _MAIL_DB.resolve().as_uri() + "?mode=ro"
        conn = sqlite3.connect(uri, uri=True, timeout=5)
        conn.row_factory = sqlite3.Row
        return conn
    except (sqlite3.Error, OSError):
        return None


@ConnectorRegistry.register("apple_mail")
class AppleMailConnector(BaseConnector):
    """Read the Outlook Inbox already synchronized by macOS Apple Mail."""

    connector_id = "apple_mail"
    display_name = "Apple Mail (local)"
    auth_type = "local"

    def __init__(self, max_messages: int = 50) -> None:
        self.max_messages = max(1, int(max_messages))
        self._items_synced = 0
        self._items_total = 0
        self._last_sync: Optional[datetime] = None
        self._error: Optional[str] = None

    def is_connected(self) -> bool:
        if not _MAIL_DB.is_file():
            return False

        if not all(
            (_MAIL_ROOT / account_id).is_dir()
            for _, account_id, _ in _ACCOUNTS
        ):
            return False

        conn = _open_mail_db()
        if conn is None:
            return False

        try:
            conn.execute("SELECT 1 FROM mailboxes LIMIT 1").fetchone()
            return True
        except sqlite3.Error:
            return False
        finally:
            conn.close()
    def disconnect(self) -> None:
        # The connector holds no credentials or persistent session.
        pass

    def sync_status(self) -> SyncStatus:
        return SyncStatus(
            state="error" if self._error else "idle",
            items_synced=self._items_synced,
            items_total=self._items_total,
            last_sync=self._last_sync,
            error=self._error,
        )


    def sync(
        self,
        *,
        since: Optional[datetime] = None,
        cursor: Optional[str] = None,
    ) -> Iterator[Document]:
        self._error = None
        self._items_synced = 0
        self._items_total = 0

        conn = _open_mail_db()
        if conn is None:
            self._error = "Could not open the local Apple Mail database."
            return

        if since is None:
            since = datetime.now(timezone.utc) - timedelta(hours=24)
        elif since.tzinfo is None:
            since = since.replace(tzinfo=_LOCAL_TZ)

        cutoff = since.timestamp()

        query = """
            SELECT
                m.ROWID AS row_id,
                m.date_received AS date_received,
                m.date_sent AS date_sent,
                m.read AS is_read,
                m.flagged AS is_flagged,
                m.conversation_id AS conversation_id,
                s.subject AS subject,
                a.address AS sender
            FROM messages m
            JOIN subjects s ON s.ROWID = m.subject
            LEFT JOIN addresses a ON a.ROWID = m.sender
            JOIN mailboxes b ON b.ROWID = m.mailbox
            WHERE b.url = ?
              AND m.deleted = 0
              AND m.date_received >= ?
            ORDER BY m.date_received DESC
            LIMIT ?
        """

        account_documents: list[list[Document]] = []

        try:
            # Fetch a bounded set from each account. The final selection
            # is round-robin so high-volume accounts cannot monopolize it.
            for account_name, account_id, inbox_url in _ACCOUNTS:

                # Gmail Inbox membership is not correctly represented
                # in the local SQLite database, so use AppleScript.
                if account_name == "Gmail":
                    try:
                        gmail_documents = _read_gmail_inbox(
                            datetime.fromtimestamp(
                                float(cutoff),
                                timezone.utc,
                            ),
                            self.max_messages,
                        )
                    except RuntimeError as exc:
                        self._error = str(exc)
                        account_documents.append([])
                        return

                    account_documents.append(gmail_documents)
                    continue

                # All other accounts use the local Mail database.
                rows = conn.execute(
                    query,
                    (inbox_url, cutoff, self.max_messages),
                ).fetchall()

                documents: list[Document] = []
                account_root = _MAIL_ROOT / account_id

                for row in rows:
                    row_id = int(row["row_id"])

                    matches = list(
                        account_root.rglob(f"{row_id}.emlx")
                    )

                    body = ""
                    body_available = False

                    if matches:
                        body, body_available = _read_emlx(matches[0])

                    sender_header = str(
                        row["sender"] or ""
                    ).strip()

                    sender_name, sender_address = parseaddr(
                        sender_header
                    )

                    sender = (
                        sender_address
                        or sender_name
                        or "Unknown sender"
                    )

                    subject = (
                        str(row["subject"] or "").strip()
                        or "(No subject)"
                    )

                    received = (
                        row["date_received"] or row["date_sent"]
                    )

                    if received is None:
                        timestamp = datetime.now(_LOCAL_TZ)
                    else:
                        timestamp = datetime.fromtimestamp(
                            float(received), timezone.utc
                        ).astimezone(_LOCAL_TZ)

                    documents.append(
                        Document(
                            doc_id=(
                                f"apple_mail:{account_id}:{row_id}"
                            ),
                            source="apple_mail",
                            doc_type="email",
                            title=subject,
                            author=sender,
                            participants=[sender],
                            content=body,
                            timestamp=timestamp,
                            thread_id=str(
                                row["conversation_id"] or ""
                            ),
                            metadata={
                                "account": account_name,
                                "unread": not bool(row["is_read"]),
                                "flagged": bool(row["is_flagged"]),
                                "body_available": body_available,
                                "mailbox": "Inbox",
                            },
                        )
                    )

                account_documents.append(documents)
        except sqlite3.Error as exc:
            self._error = (
                f"Apple Mail database query failed: {exc}"
            )
            return
        finally:
            conn.close()

        # Interleave accounts so one high-volume Inbox does not
        # consume the entire message limit.
        documents = []
        max_per_account = max(
            (len(items) for items in account_documents),
            default=0,
        )

        for index in range(max_per_account):
            for account_items in account_documents:
                if index < len(account_items):
                    documents.append(account_items[index])
                    if len(documents) >= self.max_messages:
                        break

            if len(documents) >= self.max_messages:
                break

        documents.sort(
            key=lambda doc: doc.timestamp,
            reverse=True,
        )

        self._items_total = len(documents)
        self._items_synced = len(documents)
        self._last_sync = datetime.now(timezone.utc)

        yield from documents

